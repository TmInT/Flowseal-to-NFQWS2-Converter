* text=auto

# Явные правила для бинарных ресурсов
*.syso binary
*.bin binary
*.ico binary
*.png binary
*.zip binary

# Golden-файлы и конфиги — всегда LF (байтовое сравнение в тестах)
*.conf eol=lf
*.md eol=lf
*.go eol=lf
*.html eol=lf
*.yml eol=lf

# Windows-скрипты — CRLF
*.bat eol=crlf

# Встроенный в конфиг Lua-исходник (hex в конфиге) — всегда LF, как golden-файлы
*.lua eol=lf
